# 邮件推送配置（QQ 邮箱）
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-qq-number@qq.com
SMTP_PASSWORD=your-qq-auth-code
EMAIL_RECIPIENT=recipient@example.com
# 设为 true 时仅打印邮件，不实际发送（本地测试用）
EMAIL_DRY_RUN=true

# LLM 大模型预测配置（OpenAI 兼容代理）
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.openai-proxy.org/v1
# 可选：超时(秒)/最大输出token/温度/历史窗口期数
# LLM_TIMEOUT=60
# LLM_MAX_TOKENS=800
# LLM_TEMPERATURE=0.3
# LLM_HISTORY_WINDOW=30
